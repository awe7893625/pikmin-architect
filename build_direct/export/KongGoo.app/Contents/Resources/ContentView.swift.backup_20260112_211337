        // 強制發送位置（確保在主線程執行）
        self.transmit(lat: self.currentLat + gpsErrorLat, lon: self.currentLon + gpsErrorLon)
        
        // 優化：立即繼續播放，不等待
        // 使用 DispatchQueue.main.asyncAfter 確保位置已發送後再繼續
        DispatchQueue.main.asyncAfter(deadline: .now() + 0.2) {
