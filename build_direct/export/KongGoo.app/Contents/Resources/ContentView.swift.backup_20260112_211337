            self.transmit(lat: self.currentLat + gpsErrorLat, lon: self.currentLon + gpsErrorLon)
            
            // 等待一下確保位置已發送
            Thread.sleep(forTimeInterval: 0.3)
            
            // 繼續移動
            DispatchQueue.main.async {
